# Never serve the credentials file, even if PHP is disabled on the host.
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>

# The API returns JSON only; don't let the browser sniff anything else.
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
